# Root .gitignore
node_modules/
.env
.env.local
dist/
build/
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backend uploads (keep directory structure if needed, ignore large media)
backend/uploads/audio/*
backend/uploads/images/*
backend/uploads/videos/*
!backend/uploads/**/.gitkeep
backend/.env

# Frontend
frontend/dist/
frontend/.env
frontend/.env.local
